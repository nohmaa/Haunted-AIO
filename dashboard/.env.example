# API URL for the dashboard backend (bot tunnel URL + /api/v1, printed in the bot console)
NEXT_PUBLIC_API_URL=https://haunted-api.votredomaine.com/api/v1

# API Key for authentication (if used)
NEXT_PUBLIC_DASHBOARD_API_KEY=HAUNTED_SECURE_API_KEY_12345_CHANGE_THIS_ASAP

# NextAuth Configuration
NEXTAUTH_URL=https://dashboard.votredomaine.com/
NEXTAUTH_SECRET=haunted_nextauth_default_secret_string_2026_change_me

# Discord OAuth configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Admin User IDs (comma separated)
NEXT_PUBLIC_ADMIN_IDS=870179991462236170

# Customizable Brand / Bot name shown across the dashboard
NEXT_PUBLIC_BRAND_NAME="Haunted"
NEXT_PUBLIC_BRAND_NAME_WORD="H"