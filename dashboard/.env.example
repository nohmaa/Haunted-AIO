# Private API URL for server-to-server access (bot tunnel URL + /api/v1)
API_URL=https://haunted-api.votredomaine.com/api/v1

# Private credentials shared with bot/.env. Never prefix secrets with NEXT_PUBLIC_.
DASHBOARD_API_KEY=generate-a-unique-random-secret-and-match-the-bot
DASHBOARD_PROXY_SECRET=generate-a-separate-random-secret-of-at-least-32-bytes-and-match-the-bot

# NextAuth Configuration
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Discord OAuth configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Private admin allowlist (comma-separated Discord user IDs)
DASHBOARD_ADMIN_IDS=

# Customizable Brand / Bot name shown across the dashboard
NEXT_PUBLIC_BRAND_NAME="Haunted"
NEXT_PUBLIC_BRAND_NAME_WORD="H"
